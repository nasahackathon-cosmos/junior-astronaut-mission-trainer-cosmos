# Mars terrain backend configuration. No credentials are required.
TERRAIN_DATA_ROOT=data/processed/mars_trek
TERRAIN_MAX_QUERY_POINTS=500
TERRAIN_MAX_RESPONSE_BYTES=1048576
TERRAIN_CACHE_SIZE=8
TERRAIN_DEFAULT_STRIDE=1

# NASA CCMC DONKI space-weather API configuration.
DONKI_API_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API
DONKI_TIMEOUT_SECONDS=20
DONKI_MAX_DATE_RANGE_DAYS=30
DONKI_MAX_RESULTS=100
DONKI_MAX_RESPONSE_BYTES=1048576
